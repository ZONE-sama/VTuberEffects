uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 texel_size;
uniform float sample_offset;

sampler_state linear_clamp {
	Filter = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv = v_in.uv;
	return vert_out;
}

float4 PSDownsample(VertData v_in) : TARGET
{
	float2 offset = texel_size * sample_offset;
	float4 total = image.Sample(linear_clamp, v_in.uv) * 4.0;
	total += image.Sample(linear_clamp, v_in.uv + float2(-offset.x, -offset.y));
	total += image.Sample(linear_clamp, v_in.uv + float2(offset.x, -offset.y));
	total += image.Sample(linear_clamp, v_in.uv + float2(-offset.x, offset.y));
	total += image.Sample(linear_clamp, v_in.uv + float2(offset.x, offset.y));
	return total * 0.125;
}

float4 PSUpsample(VertData v_in) : TARGET
{
	float2 offset = texel_size * sample_offset;
	float2 half_offset = offset * 0.5;
	float4 total = image.Sample(linear_clamp, v_in.uv + float2(-offset.x, 0.0));
	total += image.Sample(linear_clamp, v_in.uv + float2(offset.x, 0.0));
	total += image.Sample(linear_clamp, v_in.uv + float2(0.0, -offset.y));
	total += image.Sample(linear_clamp, v_in.uv + float2(0.0, offset.y));
	total += image.Sample(linear_clamp, v_in.uv + float2(-half_offset.x, -half_offset.y)) * 2.0;
	total += image.Sample(linear_clamp, v_in.uv + float2(half_offset.x, -half_offset.y)) * 2.0;
	total += image.Sample(linear_clamp, v_in.uv + float2(-half_offset.x, half_offset.y)) * 2.0;
	total += image.Sample(linear_clamp, v_in.uv + float2(half_offset.x, half_offset.y)) * 2.0;
	return total / 12.0;
}

technique Downsample
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader = PSDownsample(v_in);
	}
}

technique Upsample
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader = PSUpsample(v_in);
	}
}
